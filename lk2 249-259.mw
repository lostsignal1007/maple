<Input>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8">restart; # \320\236\321\207\320\270\321\201\321\202\320\272\320\260 \320\277\320\260\320\274\321\217\321\202\320\270 \320\277\320\265\321\200\320\265\320\264 \320\275\320\260\321\207\320\260\320\273\320\276\320\274 \320\262\321\213\321\207\320\270\321\201\320\273\320\265\320\275\320\270\320\271</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[51,102,255]" size="8">with(plots):</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># --- 1. \320\234\320\260\321\202\320\265\320\274\320\260\321\202\320\270\321\207\320\265\321\201\320\272\320\260\321\217 \321\207\320\260\321\201\321\202\321\214 (\320\275\320\260\321\205\320\276\320\266\320\264\320\265\320\275\320\270\320\265 \321\202\321\200\320\260\320\265\320\272\321\202\320\276\321\200\320\270\320\271) ---</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[51,102,255]" size="8">eq1 := y(x)^2 + 2*a*x = 0;</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[51,102,255]" size="8">eq2 := diff(eq1, x);</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\230\321\201\320\272\320\273\321\216\321\207\320\260\320\265\320\274 \320\277\320\260\321\200\320\260\320\274\320\265\321\202\321\200 'a' \320\270 \320\277\320\276\320\273\321\203\321\207\320\260\320\265\320\274 \320\224\320\243 \320\270\321\201\321\205\320\276\320\264\320\275\321\213\321\205 \320\273\320\270\320\275\320\270\320\271</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[51,102,255]" size="8">DE_orig := eliminate({eq1, eq2}, {a})[2][1];</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\224\320\265\320\273\320\260\320\265\320\274 \320\267\320\260\320\274\320\265\320\275\321\203 y' -&gt; -1/y' \320\264\320\273\321\217 \320\277\320\276\320\270\321\201\320\272\320\260 \320\276\321\200\321\202\320\276\320\263\320\276\320\275\320\260\320\273\321\214\320\275\321\213\321\205 \320\273\320\270\320\275\320\270\320\271</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[255,0,0]" size="8">DE_orth := subs(diff(y(x), x) = -1/diff(y(x), x), DE_orig);</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\240\320\265\321\210\320\260\320\265\320\274 \320\277\320\276\320\273\321\203\321\207\320\265\320\275\320\275\320\276\320\265 \320\264\320\270\321\204\321\204\320\265\321\200\320\265\320\275\321\206\320\270\320\260\320\273\321\214\320\275\320\276\320\265 \321\203\321\200\320\260\320\262\320\275\320\265\320\275\320\270\320\265</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[255,0,0]" size="8">sol := dsolve(DE_orth);</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># --- 2. \320\237\320\276\320\264\320\263\320\276\321\202\320\276\320\262\320\272\320\260 \320\272 \320\262\320\270\320\267\321\203\320\260\320\273\320\270\320\267\320\260\321\206\320\270\320\270 ---</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\237\320\265\321\200\320\265\320\262\320\276\320\264\320\270\320\274 \321\203\321\200\320\260\320\262\320\275\320\265\320\275\320\270\321\217 \320\270\320\267 \321\204\321\203\320\275\320\272\321\206\320\270\320\276\320\275\320\260\320\273\321\214\320\275\320\276\320\263\320\276 \320\262\320\270\320\264\320\260 y(x) \320\262 \320\276\320\261\321\213\321\207\320\275\321\213\320\265 \320\277\320\265\321\200\320\265\320\274\320\265\320\275\320\275\321\213\320\265 y \320\264\320\273\321\217 \320\263\321\200\320\260\321\204\320\270\320\272\320\260</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\224\320\273\321\217 \320\270\321\201\321\205\320\276\320\264\320\275\321\213\321\205 \320\273\320\270\320\275\320\270\320\271:</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[51,102,255]" size="8">plot_orig := subs(y(x) = y, eq1); </Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\224\320\273\321\217 \320\276\321\200\321\202\320\276\320\263\320\276\320\275\320\260\320\273\321\214\320\275\321\213\321\205 \321\202\321\200\320\260\320\265\320\272\321\202\320\276\321\200\320\270\320\271 (\320\262\321\213\321\202\320\260\321\201\320\272\320\270\320\262\320\260\320\265\320\274 \321\201\320\260\320\274\320\276 \321\203\321\200\320\260\320\262\320\275\320\265\320\275\320\270\320\265 \320\270\320\267 \321\200\320\265\321\210\320\265\320\275\320\270\321\217 dsolve):</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># Maple \320\267\320\260\320\274\320\265\320\275\321\217\320\265\321\202 \320\272\320\276\320\275\321\201\321\202\320\260\320\275\321\202\321\203 \320\270\320\275\321\202\320\265\320\263\321\200\320\270\321\200\320\276\320\262\320\260\320\275\320\270\321\217 \320\275\320\260 _C1. \320\227\320\260\320\274\320\265\320\275\320\270\320\274 \320\265\321\221 \320\275\320\260 \320\277\320\260\321\200\320\260\320\274\320\265\321\202\321\200 'b' \320\264\320\273\321\217 \321\203\320\264\320\276\320\261\321\201\321\202\320\262\320\260.</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[255,0,0]" size="8">plot_orth := subs([y(x) = y, _C1 = b], sol);</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># --- 3. \320\237\320\276\321\201\321\202\321\200\320\276\320\265\320\275\320\270\320\265 \320\263\321\200\320\260\321\204\320\270\320\272\320\276\320\262 ---</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\241\321\202\321\200\320\276\320\270\320\274 \320\270\321\201\321\205\320\276\320\264\320\275\320\276\320\265 \321\201\320\265\320\274\320\265\320\271\321\201\321\202\320\262\320\276 \320\277\320\260\321\200\320\260\320\261\320\276\320\273 (\320\272\321\200\320\260\321\201\320\275\321\213\320\274 \321\206\320\262\320\265\321\202\320\276\320\274) \320\264\320\273\321\217 \321\200\320\260\320\267\320\275\321\213\321\205 \320\267\320\275\320\260\321\207\320\265\320\275\320\270\320\271 'a'</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\237\320\276 \321\203\321\201\320\273\320\276\320\262\320\270\321\216 \320\267\320\260\320\264\320\260\321\207\320\270 249, a &gt; 0, \320\262\320\276\320\267\321\214\320\274\320\265\320\274 a \320\276\321\202 1 \320\264\320\276 5</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[255,0,0]" size="8">curves_orig := [seq(implicitplot(eval(plot_orig, a = i), x = -10 .. 2, y = -8 .. 8, color = red, thickness = 2), i = 1 .. 5)]:</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\241\321\202\321\200\320\276\320\270\320\274 \320\276\321\200\321\202\320\276\320\263\320\276\320\275\320\260\320\273\321\214\320\275\320\276\320\265 \321\201\320\265\320\274\320\265\320\271\321\201\321\202\320\262\320\276 \321\215\320\273\320\273\320\270\320\277\321\201\320\276\320\262 (\321\201\320\270\320\275\320\270\320\274 \321\206\320\262\320\265\321\202\320\276\320\274) \320\264\320\273\321\217 \321\200\320\260\320\267\320\275\321\213\321\205 \320\267\320\275\320\260\321\207\320\265\320\275\320\270\320\271 'b'</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># (\320\227\320\264\320\265\321\201\321\214 b \342\200\224 \321\215\321\202\320\276 \320\272\320\276\320\275\321\201\321\202\320\260\320\275\321\202\320\260 \321\215\320\275\320\265\321\200\320\263\320\270\320\270/\321\200\320\260\320\264\320\270\321\203\321\201\320\260, \320\262\320\276\320\267\321\214\320\274\320\265\320\274 \320\276\321\202 5 \320\264\320\276 45 \321\201 \321\210\320\260\320\263\320\276\320\274 10)</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font foreground="[255,0,0]" size="8">curves_orth := [seq(implicitplot(eval(plot_orth, b = j), x = -10 .. 10, y = -8 .. 8, color = blue, thickness = 2), j = seq(5 + 10*k, k = 0 .. 4))]:</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[51,102,255]" size="8"># \320\236\321\202\320\276\320\261\321\200\320\260\320\266\320\260\320\265\320\274 \320\262\321\201\321\221 \320\262\320\274\320\265\321\201\321\202\320\265 \320\275\320\260 \320\276\320\264\320\275\320\276\320\274 \321\215\320\272\321\200\320\260\320\275\320\265</Font></Text-field>
<Text-field style="Text" size="8" foreground="[51,102,255]" layout="Normal"><Font encoding="UTF-8" foreground="[255,0,0]" size="8">display([op(curves_orig), op(curves_orth)], scaling = constrained, title = &quot;\320\236\321\200\321\202\320\276\320\263\320\276\320\275\320\260\320\273\321\214\320\275\321\213\320\265 \321\202\321\200\320\260\320\265\320\272\321\202\320\276\321\200\320\270\320\270 (\320\232\321\200\320\260\321\201\320\275\321\213\320\271 - \320\230\321\201\321\205\320\276\320\264\320\275\321\213\320\265, \320\241\320\270\320\275\320\270\320\271 - \320\236\321\200\321\202\320\276\320\263\320\276\320\275\320\260\320\273\321\214\320\275\321\213\320\265)&quot;);</Font></Text-field>
<Text-field style="Text" layout="Normal"></Text-field>
</Input>
